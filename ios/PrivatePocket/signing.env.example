# Copy to signing.env (gitignored) and fill in. Used by sign-install.sh.
#   DEVICE         xcrun devicectl list devices            (the phone's identifier)
#   PROFILE        a development provisioning profile's UUID that covers your bundle id and phone
#                  (~/Library/MobileDevice/Provisioning Profiles/<uuid>.mobileprovision)
#   IDENTITY       security find-identity -v -p codesigning (SHA-1 of an Apple Development certificate)
#   APP_ID_PREFIX  the profile's ApplicationIdentifierPrefix
#   TEAM_ID        your team id
DEVICE=
PROFILE=
IDENTITY=
APP_ID_PREFIX=
TEAM_ID=
