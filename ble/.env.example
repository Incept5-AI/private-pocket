# Copy to ble/.env (gitignored). Read by the Mac tools (POCKET_SK) and baked into the
# iOS app at build time by ios/PrivatePocket/gen-defaults.sh. Everything is optional.

# Your Pocket: its advertised Bluetooth name (uv run scan.py shows it) and, optionally,
# a session key. The app pairs on its own (side button held 5 s, then Pair); a key here
# is for the Mac tools, or to bake a known key into the app. See PROTOCOL.md,
# "Session key and pairing".
POCKET_SK=
POCKET_ADVERTISED=          # e.g. PKT01_GREY_2617abcd
POCKET_NAME=                # defaults to Pocket-<last 4 of the advertised name>

# A default server for speech to text, summaries and speakers (OpenAI-compatible).
# Leave SERVER_URL empty to run everything on the iPhone.
SERVER_NAME="my server"
SERVER_URL=                 # e.g. https://llm.example.com/v1
SERVER_KEY=
STT_MODEL=                  # e.g. whisper-large-v3
STT_MODELS=                 # comma-separated suggestions shown in Settings
LLM_MODEL=
LLM_MODELS=
DIARIZE_URLS=               # e.g. http://gpu1:8000/v1, http://gpu2:8000/v1
